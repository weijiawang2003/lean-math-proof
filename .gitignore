# Claude Code session metadata
.claude/

# AlphaEvolve outer loop — eval artifacts and the running population log
# are local only. Generated by `python -m evolve.run_evolve`. Reports
# under project/evolve/reports/ ARE committed.
project/evolve/runs/
project/evolve/population.jsonl

# Model checkpoint directories (binaries, large). gen_v5 etc. live here
# locally but are not committed.
project/models/

# NS5 skeleton-evolution autonomous-run artifacts and the accumulated
# archive ledger. The archive grows to ~10MB per ~150-cycle run and is
# regeneratable by re-running `evolve.skeleton_evolve` — kept local only.
project/evolve/skeleton_runs/
project/evolve/archive/

# NS6 credit-aware-mutation run artifacts. Per-step traces + per-cycle
# evals + the credit_index dump. Regeneratable by re-running
# `evolve.skeleton_evolve_ns6`.
project/evolve/ns6_runs/

# NS7 rank-stable-mutation run artifacts and protected-skeleton dumps.
# Regeneratable by re-running `evolve.skeleton_evolve_ns7` plus
# `scripts/ns7_protected_set.py`.
project/evolve/ns7_runs/

# NS8 rank-simulation pre-flight artifacts: run dirs, the model-output
# cache (deterministic, regeneratable from gen_v5 in ~30s), and the
# per-state protected-states file. Regeneratable by re-running
# `scripts/ns8_protected_states.py`, `scripts/ns8_cache_model_outputs.py`,
# and `evolve.skeleton_evolve_ns8`.
project/evolve/ns8_runs/
project/evolve/archive/model_outputs_cache.jsonl
project/evolve/archive/protected_states.jsonl
project/evolve/archive/cache.log

# NS9 retrieval-gate-decoupling artifacts. Regeneratable by re-running
# `evolve.skeleton_evolve_ns8` on the NS9 seed genome (with
# retrieval_requires_family=False and retrieval_family_gates set).
project/evolve/ns9_runs/

# NS10 Learn-step artifacts. The training data and resulting model
