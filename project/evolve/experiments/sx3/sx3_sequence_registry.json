{
  "registry_version": "sx3.v1",
  "description": "SX3 depth-2 symbolic proof-sequence families. All off-by-default. Only SX3_SET_ITE_AESOP is a plausible RC3 candidate; everything else is exploratory or diagnostic.",
  "global_constraints": {
    "max_one_sequence_emission_per_theorem_for_candidate": true,
    "run_transition_single_line_only": true,
    "forbid_bare_semicolon_chains": true,
    "forbid_multiline_bullet_blocks": true
  },
  "controls_always_run": ["simp", "simp_all", "aesop", "classical <;> aesop", "simp [Set.ite]"],
