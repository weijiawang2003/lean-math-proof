    "SX3_SET_ITE_AESOP": {
      "family": "SX3_SET_ITE_AESOP",
      "sequence": "simp [Set.ite] <;> aesop",
      "base_step": "simp [Set.ite]",
      "close_step": "aesop",
      "gate": {
        "namespace_or_name_contains": ["Set."],
        "signal": ["ite", "if", "Set.ite"],
        "target_shape": ["set_equality", "set_membership", "set_iff_involving_ite"],
        "forbid_namespaces": ["Nat", "Int", "Multiset"]
      },
      "status": "experimental_off_by_default",
      "promotion_allowed": false,
      "requires_minimal_relabel": true,
      "requires_rc2_baseline_comparison": true,
      "source": "rc2_deferred",
      "risk": "low",
      "provenance": "RC2 hardening deferred +4",
      "expected_wins": ["Set.ite_inter", "Set.ite_inter_self", "Set.ite_compl", "Set.ite_inter_compl_self"]
    },
    "SX3_SET_ITE_SIMPALL": {
      "family": "SX3_SET_ITE_SIMPALL",
