      "cases k <;> [skip; (rw [Nat.add_mod]; split_ifs with h <;> first | (exact Nat.mod_eq_of_lt (Nat.lt_of_not_ge h)) | (rw [Nat.mod_eq_sub_mod h]; exact Nat.mod_eq_of_lt ((Nat.sub_lt_iff_lt_add h).mpr (Nat.add_lt_add (Nat.mod_lt _ (by omega)) (Nat.mod_lt _ (by omega))))))]"
    ],
    "eq": [
      "exact Nat.eq_one_of_mul_eq_one_right (by rwa [Nat.mul_comm])"
    ],
    "le": [
      "by_cases hc : c = 0 <;> [simp [hc]; exact (Nat.le_div_iff_mul_le' (Nat.pos_of_ne_zero hc)).2 (Nat.le_trans (Nat.div_mul_le_self _ _) {hyp_le})]"
    ]
